        "jsCode": "if (!$json.ok) throw new Error('Render retornou erro: '+JSON.stringify($json));\nif (!Array.isArray($json.cards_data_uri) || $json.cards_data_uri.length < 3) throw new Error('Render não retornou 3 cards_data_uri.');\nfor (const [idx, uri] of $json.cards_data_uri.entries()) { if (!String(uri).startsWith('data:image/jpeg;base64,/9j/')) throw new Error(`Card ${idx+1} não parece JPEG válido.`); }\nreturn [{json:{ok:true,cards_urls:$json.cards_urls,cards_count:$json.cards_data_uri.length,first_card_prefix:$json.cards_data_uri[0].slice(0,80)}}];"
      },
